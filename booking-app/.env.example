# Local development only. Keep real credentials in .env or the Azure host configuration.
NODE_ENV=development
ELUNORA_DATABASE_BACKEND=sqlite
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=write_draft_orders,read_orders

# Production selects azure-postgres and uses the existing managed identity.
# Configure ELUNORA_PG_HOST, ELUNORA_PG_DATABASE, ELUNORA_PG_USER,
# and ELUNORA_PG_IDENTITY_CLIENT_ID in Azure. Never commit passwords or tokens.
# Mail delivery, Google Calendar and gallery integration remain configured in Azure.

# Assistant is opt-in. See ../docs/azure-storefront-assistant.md before enabling.
ELUNORA_CHAT_ENABLED=false
ELUNORA_CHAT_SHOPS=v0j63n-ms.myshopify.com
ELUNORA_CHAT_SESSION_SECRET=
ELUNORA_CHAT_AZURE_ENDPOINT=
ELUNORA_CHAT_AZURE_DEPLOYMENT=
# Existing booking identity, with an explicit Azure OpenAI role assignment.
ELUNORA_CHAT_IDENTITY_CLIENT_ID=
# Optional server-only key / Key Vault reference instead of managed identity.
ELUNORA_CHAT_AZURE_KEY=
