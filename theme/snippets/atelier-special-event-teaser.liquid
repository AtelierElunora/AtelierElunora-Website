{% doc %}
Links event visitors to the special-event quote page.
{% enddoc %}
<aside class="aes-teaser"><div><h2>{{ 'special_events.teaser_title' | t }}</h2><p>{{ 'special_events.teaser_body' | t }}</p></div><a href="/pages/special-events">{{ 'special_events.cta' | t }}</a></aside>
{% stylesheet %}
.aes-teaser{display:flex;justify-content:space-between;align-items:center;gap:28px;padding:28px;margin:0 0 36px;background:#e9e5d9;border:1px solid #b19a7377;color:#252b1d}.aes-teaser h2{font-size:24px!important;line-height:1.3;margin:0 0 12px!important}.aes-teaser p{font-size:15px;line-height:1.6;margin:0;max-width:65ch}.aes-teaser a{flex-shrink:0;display:block;max-width:260px;padding:14px 20px;background:#252b1d;color:#f4f2ef!important;font-size:14px;line-height:1.5;text-align:center;text-decoration:none}.aes-teaser a:focus-visible{outline:2px solid #766345;outline-offset:4px}@media(max-width:749px){.aes-teaser{flex-direction:column;align-items:stretch;padding:24px}.aes-teaser a{max-width:none}}
{% endstylesheet %}
