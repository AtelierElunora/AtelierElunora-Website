{%- doc -%}
  Renders current event prices and retainers from the event product variants.
{%- enddoc -%}
<table data-ae-event-pricing>
  <thead><tr><th scope="col">Collection &amp; total guest count</th><th scope="col">Event price</th><th scope="col">30% retainer</th></tr></thead>
  <tbody>
    <tr><th scope="row">Intimate — Up to 100 guests</th><td>{% render 'atelier-event-price', tier: 100 %}</td><td>{% render 'atelier-event-price', tier: 100, retainer: true %}</td></tr>
    <tr><th scope="row">Signature — 101–150 guests</th><td>{% render 'atelier-event-price', tier: 150 %}</td><td>{% render 'atelier-event-price', tier: 150, retainer: true %}</td></tr>
    <tr><th scope="row">Celebration — 151–200 guests</th><td>{% render 'atelier-event-price', tier: 200 %}</td><td>{% render 'atelier-event-price', tier: 200, retainer: true %}</td></tr>
    <tr><th scope="row">Grand — 201–250 guests</th><td>{% render 'atelier-event-price', tier: 250 %}</td><td>{% render 'atelier-event-price', tier: 250, retainer: true %}</td></tr>
    <tr><th scope="row">Premier — 251–300 guests</th><td>{% render 'atelier-event-price', tier: 300 %}</td><td>{% render 'atelier-event-price', tier: 300, retainer: true %}</td></tr>
  </tbody>
</table>
