{% doc %}
Shared presentation for the refreshed information pages and homepage choices.
{% enddoc %}
{% stylesheet %}
.aef{box-sizing:border-box;max-width:1240px;margin:0 auto;padding:56px 32px 72px;color:#252b1d}
.aef *{box-sizing:border-box}.aef [hidden]{display:none!important}
.aef h1{font-size:clamp(34px,4.2vw,56px);line-height:1.15;max-width:19ch;margin:0 0 24px;text-wrap:balance}
.aef h2{font-size:clamp(27px,3vw,38px);line-height:1.2;margin:0 0 28px;text-wrap:balance}
.aef h3{font-size:22px;line-height:1.3;margin:0 0 12px}
.aef p,.aef li{font-size:16px;line-height:1.65;margin:0 0 16px}
.aef .aef-kicker{font-size:11px;line-height:1.6;text-transform:uppercase;letter-spacing:.14em;margin:0 0 18px}
.aef .aef-intro{font-size:18px;line-height:1.6;max-width:58ch}
.aef .aef-heading{margin-bottom:32px}.aef .aef-hero{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.aef .aef-hero-image{aspect-ratio:1;overflow:hidden}.aef .aef-hero-image img{width:100%;height:100%;object-fit:cover;display:block}
.aef .aef-price{font-size:26px}.aef .aef-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin:24px 0}
.aef a{color:inherit;font-size:15px;text-underline-offset:5px}
.aef a.aef-button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:14px 24px;border:1px solid #252b1d;background:#252b1d;color:#f4f2ef;text-decoration:none;line-height:1.5;text-align:center}
.aef a.aef-button:hover{background:#4a4b36}.aef a:focus-visible,.aef summary:focus-visible{outline:2px solid #252b1d;outline-offset:5px}
.aef .aef-link{font-size:14px;text-decoration:underline;text-underline-offset:5px}
.aef .aef-section{padding:52px 0;border-bottom:1px solid #b19a7366;scroll-margin-top:112px}
.aef .aef-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}
.aef .aef-offer-card{display:flex;flex-direction:column;text-decoration:none;background:#f4f2ef;border:1px solid #d6d2bc;min-width:0}
.aef .aef-offer-card:hover{border-color:#766345}.aef .aef-offer-image{aspect-ratio:4/5;overflow:hidden;background:#d6d2bc}
.aef .aef-offer-image img{display:block;width:100%;height:100%;object-fit:cover}
.aef .aef-offer-card:last-child .aef-offer-image img{object-fit:contain;background:#e7e5d9}
.aef .aef-offer-copy{padding:28px;flex:1;display:flex;flex-direction:column}.aef .aef-offer-copy .aef-link{margin-top:auto}
.aef .aef-packs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.aef .aef-pack{display:block;text-decoration:none;background:#f4f2ef;border:1px solid #d6d2bc;padding:24px 18px;min-width:0}
.aef .aef-pack:hover{border-color:#766345}.aef .aef-pack h3{font-size:21px}
.aef .aef-pack-art{display:grid;grid-template-columns:repeat(6,1fr);align-content:start;gap:4px;height:160px;max-width:128px;margin:0 0 24px}
.aef .aef-pack-art span{display:block;aspect-ratio:1;background:#888d6f;border:1px solid #4a4b36}
.aef .aef-small{font-size:13px;margin:18px 0 0;max-width:70ch}
.aef .aef-steps{padding:0;margin:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:28px}
.aef .aef-number{display:block;font-size:38px;line-height:1;color:#766345;margin:0 0 22px}
.aef .aef-life-image{aspect-ratio:1;overflow:hidden;margin-bottom:20px;background:#d6d2bc}.aef .aef-life-image img{display:block;width:100%;height:100%;object-fit:cover}
.aef .aef-life:first-child img{object-fit:contain;background:#e7e5d9}
.aef .aef-note{padding:24px 28px;background:#f4f2ef;border-left:3px solid #b19a73;margin:24px 0}.aef .aef-note p:last-child{margin-bottom:0}
.aef .aef-note h2{font-size:25px;margin-bottom:20px}
.aef .aef-choices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;align-items:start}
.aef .aef-choice{border:1px solid #b19a7388;background:#f4f2ef;min-width:0}
.aef .aef-choice[open]{border-color:#4a4b36}.aef .aef-choice summary{padding:26px 22px;cursor:pointer}
.aef .aef-choice-title{display:inline;font-size:21px;line-height:1.3}.aef .aef-choice-sub{display:block;font-size:15px;line-height:1.6;margin:14px 0 18px}
.aef .aef-choice-action{display:block;font-size:13px;text-decoration:underline;text-underline-offset:4px}
.aef .aef-choice-content{padding:0 22px 26px;border-top:1px solid #d6d2bc}.aef .aef-choice-content .aef-steps{display:block;padding-top:26px}
.aef .aef-choice-content .aef-number{font-size:25px;margin:0 0 10px}.aef .aef-choice-content h3{font-size:19px}.aef .aef-choice-content p{font-size:15px}
.aef .aef-choice-content li{margin-bottom:28px}
.aef .aef-faq{border-top:1px solid #d6d2bc;padding:0}.aef .aef-faq summary{padding:20px 0;font-size:18px;line-height:1.5;cursor:pointer}
.aef .aef-answer{max-width:75ch;padding:0 24px 10px}.aef .aef-topics{display:flex;gap:12px;flex-wrap:wrap;margin:28px 0}
.aef .aef-topics a{display:inline-flex;align-items:center;min-height:44px;padding:10px 20px;border:1px solid #b19a73;text-decoration:none}
.aef .aef-topics a:hover{background:#f4f2ef}.aef .aef-chips{display:flex;flex-wrap:wrap;gap:12px;list-style:none;margin:0;padding:0}
.aef .aef-chips li{border:1px solid #d6d2bc;padding:8px 14px;margin:0;font-size:14px}
.aef .aef-callout{text-align:center;padding:52px 12px 0}.aef .aef-callout p{max-width:60ch;margin:0 auto 24px}.aef .aef-callout h2{margin-bottom:20px}
@media(max-width:1000px){.aef .aef-hero{gap:28px}.aef .aef-offer-copy{padding:20px}.aef .aef-packs{grid-template-columns:repeat(2,minmax(0,1fr))}.aef .aef-choices{grid-template-columns:1fr}.aef .aef-choice-content .aef-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:749px){.aef{padding:36px 20px 48px}.aef .aef-hero{grid-template-columns:1fr;gap:24px}.aef .aef-grid{grid-template-columns:1fr;gap:28px}.aef .aef-offer-image{aspect-ratio:4/3}.aef .aef-section{padding:36px 0}.aef .aef-pack{padding:20px 14px}.aef .aef-pack-art{height:145px;max-width:110px}.aef .aef-steps{grid-template-columns:1fr}.aef .aef-steps li{border-bottom:1px solid #d6d2bc;padding-bottom:16px}.aef .aef-number{font-size:30px;margin-bottom:14px}.aef .aef-choice-content .aef-steps{display:block}.aef .aef-callout{padding:36px 0 0}.aef .aef-note{padding:22px}.aef .aef-topics{gap:8px}.aef .aef-topics a{padding:10px 14px}.aef .aef-answer{padding-left:12px;padding-right:12px}}
{% endstylesheet %}
