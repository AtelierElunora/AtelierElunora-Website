summary>{{ 'site_refresh.keepsake_frame_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.keepsake_frame_a' | t }}</p></div></details><a class="aef-link" href="/pages/personalize-your-wedding-keepsake">{{ 'site_refresh.faq_personal' | t }}</a></section><section class="aef-section" id="aef-returns"><h2>{{ 'audit_returns.title' | t }}</h2><details class="aef-faq"><summary>{{ 'audit_returns.q1' | t }}</summary><div class="aef-answer"><p>{{ 'audit_returns.a1' | t }}</p></div></details><details class="aef-faq"><summary>{{ 'audit_returns.q2' | t }}</summary><div class="aef-answer"><p>{{ 'audit_returns.a2' | t }}</p></div></details><details class="aef-faq"><summary>{{ 'audit_returns.q3' | t }}</summary><div class="aef-answer"><p>{{ 'audit_returns.a3' | t }}</p></div></details></section><div class="aef-callout"><h2>{{ 'site_refresh.faq_more' | t }}</h2><a class="aef-button" href="/pages/contact">{{ 'site_refresh.faq_contact' | t }}</a></div>{% endcase %}</div>