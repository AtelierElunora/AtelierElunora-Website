{% doc %}
Renders the refreshed shop, personalization, booking and FAQ pages.
@param {string} page_handle - The page handle selecting the content.
{% enddoc %}
{% render 'atelier-refresh-styles' %}<div class="aef">{% case page_handle %}{% when 'shop-custom-magnets' %}{% assign magnet_product = all_products['custom-photo-magnets'] %}<div class="aef-hero"><div><header class="aef-heading"><p class="aef-kicker">{{ 'site_refresh.shop_eyebrow' | t }}</p><h1>{{ 'site_refresh.shop_title' | t }}</h1><p class="aef-intro">{{ 'site_refresh.shop_intro' | t }}</p></header><p class="aef-price">{{ 'site_refresh.from' | t }} {{ magnet_product.price_min | money }}</p><div class="aef-actions"><a class="aef-button" href="/products/custom-photo-magnets">{{ 'site_refresh.create' | t }}</a></div></div><div class="aef-hero-image">{% assign visual_product = all_products['custom-photo-magnets'] %}{% if visual_product.featured_image != blank %}{{ visual_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 1000', sizes: '(max-width: 749px) 100vw, 33vw', alt: '' }}{% endif %}</div></div><section class="aef-section"><p class="aef-kicker">{{ 'site_refresh.sets_eyebrow' | t }}</p><h2>{{ 'site_refresh.sets_title' | t }}</h2><div class="aef-packs">{% for pack in magnet_product.variants %}{% assign pack_count = pack.title | split: " " | first | plus: 0 %}<a class="aef-pack" href="{{ magnet_product.url }}?variant={{ pack.id }}"><div class="aef-pack-art" aria-hidden="true">{% for square in (1..pack_count) %}<span></span>{% endfor %}</div><h3>{{ pack.title | escape }}</h3><p>{{ pack.price | money }}</p><span class="aef-link">{{ 'site_refresh.select_set' | t }}</span></a>{% endfor %}</div><p class="aef-small">{{ 'site_refresh.pack_note' | t }}</p></section><section class="aef-section"><h2>{{ 'site_refresh.shop_steps_title' | t }}</h2><ol class="aef-steps"><li><span class="aef-number" aria-hidden="true">01</span><h3>{{ 'site_refresh.shop_step0_title' | t }}</h3><p>{{ 'site_refresh.shop_step0_body' | t }}</p></li><li><span class="aef-number" aria-hidden="true">02</span><h3>{{ 'site_refresh.shop_step1_title' | t }}</h3><p>{{ 'site_refresh.shop_step1_body' | t }}</p></li><li><span class="aef-number" aria-hidden="true">03</span><h3>{{ 'site_refresh.shop_step2_title' | t }}</h3><p>{{ 'site_refresh.shop_step2_body' | t }}</p></li><li><span class="aef-number" aria-hidden="true">04</span><h3>{{ 'site_refresh.shop_step3_title' | t }}</h3><p>{{ 'site_refresh.shop_step3_body' | t }}</p></li></ol></section><section class="aef-section"><h2>{{ 'site_refresh.life_title' | t }}</h2><div class="aef-grid"><article class="aef-life"><div class="aef-life-image">{% assign visual_product = all_products['the-magnetic-keepsake-frame'] %}{% if visual_product.featured_image != blank %}{{ visual_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 1000', sizes: '(max-width: 749px) 100vw, 33vw', alt: '' }}{% endif %}</div><h3>{{ 'site_refresh.life0' | t }}</h3><p>{{ 'site_refresh.lifeb0' | t }}</p></article><article class="aef-life"><div class="aef-life-image">{% assign visual_product = all_products['wedding-event-photo-magnet-experience'] %}{% if visual_product.featured_image != blank %}{{ visual_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 1000', sizes: '(max-width: 749px) 100vw, 33vw', alt: '' }}{% endif %}</div><h3>{{ 'site_refresh.life1' | t }}</h3><p>{{ 'site_refresh.lifeb1' | t }}</p></article><article class="aef-life"><div class="aef-life-image">{% assign visual_product = all_products['after-wedding-couple-magnet-collection'] %}{% if visual_product.featured_image != blank %}{{ visual_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 1000', sizes: '(max-width: 749px) 100vw, 33vw', alt: '' }}{% endif %}</div><h3>{{ 'site_refresh.life2' | t }}</h3><p>{{ 'site_refresh.lifeb2' | t }}</p></article></div></section><section class="aef-section"><details class="aef-faq"><summary>{{ 'site_refresh.photo_tips_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.photo_tips_a' | t }}</p></div></details><div class="aef-callout"><h2>{{ 'site_refresh.bulk_title' | t }}</h2><p>{{ 'site_refresh.bulk_body' | t }}</p><a class="aef-button" href="/pages/contact">{{ 'site_refresh.bulk_link' | t }}</a></div></section>{% when 'personalize-your-wedding-keepsake' %}<header class="aef-heading"><p class="aef-kicker">{{ 'site_refresh.personal_eyebrow' | t }}</p><h1>{{ 'site_refresh.personal_title' | t }}</h1><p class="aef-intro">{{ 'site_refresh.personal_intro' | t }}</p></header><div class="aef-note"><p>{{ 'site_refresh.personal_ready' | t }}</p></div><section class="aef-section"><h2>{{ 'site_refresh.personal_options' | t }}</h2><div class="aef-choices"><details class="aef-choice" name="wedding-photo-choice"><summary><span class="aef-choice-title">{{ 'site_refresh.night_name' | t }}</span><span class="aef-choice-sub">{{ 'site_refresh.night_sub' | t }}</span><span class="aef-choice-action">{{ 'site_refresh.night_action' | t }}</span></summary><div class="aef-choice-content"><ol class="aef-steps"><li><span class="aef-number" aria-hidden="true">01</span><h3>{{ 'site_refresh.night_step0_title' | t }}</h3><p>{{ 'site_refresh.night_step0_body' | t }}</p></li><li><span class="aef-number" aria-hidden="true">02</span><h3>{{ 'site_refresh.night_step1_title' | t }}</h3><p>{{ 'site_refresh.night_step1_body' | t }}</p></li><li><span class="aef-number" aria-hidden="true">03</span><h3>{{ 'site_refresh.night_step2_title' | t }}</h3><p>{{ 'site_refresh.night_step2_body' | t }}</p></li></ol><p>{{ 'site_refresh.night_note' | t }}</p><a class="aef-link" href="mailto:support@atelierelunora.com?subject=Wedding%20keepsake%20personalization">{{ 'site_refresh.night_help' | t }}</a></div></details><details class="aef-choice" name="wedding-photo-choice"><summary><span class="aef-choice-title">{{ 'site_refresh.own_name' | t }}</span><span class="aef-choice-sub">{{ 'site_refresh.own_sub' | t }}</span><span class="aef-choice-action">{{ 'site_refresh.own_action' | t }}</s