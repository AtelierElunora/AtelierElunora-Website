mmary>{{ 'site_refresh.permissions_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.permissions_a' | t }}</p></div></details></section><div class="aef-callout"><h2>{{ 'site_refresh.need_link' | t }}</h2><p>{{ 'site_refresh.link_help' | t }}</p><a class="aef-button" href="mailto:support@atelierelunora.com?subject=Wedding%20keepsake%20personalization">{{ 'site_refresh.personal_help' | t }}</a></div>{% when 'booking-availability' %}<header class="aef-heading"><p class="aef-kicker">{{ 'site_refresh.booking_eyebrow' | t }}</p><h1>{{ 'site_refresh.booking_title' | t }}</h1><p class="aef-intro">{{ 'site_refresh.booking_intro' | t }}</p></header><div class="aef-actions"><a class="aef-button" href="/products/wedding-event-photo-magnet-experience">{{ 'site_refresh.booking_start' | t }}</a><a class="aef-link" href="/pages/packages">{{ 'site_refresh.booking_prices' | t }}</a></div><p class="aef-small">{{ 'site_refresh.booking_second_event' | t }} <a href="/pages/contact">{{ 'site_refresh.booking_inquire' | t }}</a></p><section class="aef-section"><ol class="aef-steps"><li><span class="aef-number" aria-hidden="true">01</span><h3>{{ 'site_refresh.booking_step0_title' | t }}</h3><p>{{ 'site_refresh.booking_step0_body' | t }}</p></li><li><span class="aef-number" aria-hidden="true">02</span><h3>{{ 'site_refresh.booking_step1_title' | t }}</h3><p>{{ 'site_refresh.booking_step1_body' | t }}</p></li><li><span class="aef-number" aria-hidden="true">03</span><h3>{{ 'site_refresh.booking_step2_title' | t }}</h3><p>{{ 'site_refresh.booking_step2_body' | t }}</p></li></ol></section>{% render 'atelier-event-travel' %}<div class="aef-note"><h2>{{ 'site_refresh.booking_ready' | t }}</h2><ul class="aef-chips"><li>{{ 'site_refresh.date' | t }}</li><li>{{ 'site_refresh.venue' | t }}</li><li>{{ 'site_refresh.guests' | t }}</li></ul></div><section class="aef-section"><details class="aef-faq"><summary>{{ 'site_refresh.booking_payment_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.booking_payment_a' | t }}</p></div></details><details class="aef-faq"><summary>{{ 'site_refresh.booking_limits_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.booking_limits_a' | t }}</p></div></details><details class="aef-faq"><summary>{{ 'site_refresh.booking_next_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.booking_next_a' | t }}</p></div></details></section><div class="aef-callout"><h2>{{ 'site_refresh.booking_question' | t }}</h2><a class="aef-button" href="/pages/contact">{{ 'site_refresh.booking_inquire' | t }}</a></div>{% when 'faq' %}<header class="aef-heading"><p class="aef-kicker">{{ 'site_refresh.faq_eyebrow' | t }}</p><h1>{{ 'site_refresh.faq_title' | t }}</h1><p class="aef-intro">{{ 'site_refresh.faq_intro' | t }}</p></header><nav class="aef-topics" aria-label="{{ 'site_refresh.faq_nav' | t }}"><a class="aef-link" href="#aef-events">{{ 'site_refresh.jump_events' | t }}</a><a class="aef-link" href="#aef-magnets">{{ 'site_refresh.jump_magnets' | t }}</a><a class="aef-link" href="#aef-keepsakes">{{ 'site_refresh.jump_keepsakes' | t }}</a></nav><section class="aef-section" id="aef-events"><h2>{{ 'site_refresh.events_group' | t }}</h2><details class="aef-faq"><summary>{{ 'event_travel.area_q' | t }}</summary><div class="aef-answer"><p>{{ 'event_travel.area' | t }}</p></div></details><details class="aef-faq"><summary>{{ 'event_travel.travel_q' | t }}</summary><div class="aef-answer">{% render 'atelier-event-travel' %}</div></details><details class="aef-faq"><summary>{{ 'site_refresh.event_what_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.event_what_a' | t }}</p></div></details><details class="aef-faq"><summary>{{ 'site_refresh.event_only_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.event_only_a' | t }}</p></div></details><details class="aef-faq"><summary>{{ 'site_refresh.event_availability_q' | t }}</summary><div class="aef-answer"><p>{{ 'site_refresh.event_availability_a' | t }}<