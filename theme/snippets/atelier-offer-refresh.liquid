{% doc %}
Renders three photographic homepage service choices.
{% enddoc %}
{% render 'atelier-refresh-styles' %}<section class="aef aef-offers"><p class="aef-kicker">{{ 'site_refresh.offer_kicker' | t }}</p><h2>{{ 'site_refresh.offer_title' | t }}</h2><div class="aef-grid"><a class="aef-offer-card" href="/pages/packages"><div class="aef-offer-image">{% assign visual_product = all_products['wedding-event-photo-magnet-experience'] %}{% if visual_product.featured_image != blank %}{{ visual_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 1000', sizes: '(max-width: 749px) 100vw, 33vw', alt: '' }}{% endif %}</div><div class="aef-offer-copy"><h3>{{ 'site_refresh.offer_events' | t }}</h3><p>{{ 'site_refresh.offer_events_body' | t }}</p><span class="aef-link">{{ 'site_refresh.offer_events_cta' | t }}</span></div></a><a class="aef-offer-card" href="/products/custom-photo-magnets"><div class="aef-offer-image">{% assign visual_product = all_products['custom-photo-magnets'] %}{% if visual_product.featured_image != blank %}{{ visual_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 1000', sizes: '(max-width: 749px) 100vw, 33vw', alt: '' }}{% endif %}</div><div class="aef-offer-copy"><h3>{{ 'site_refresh.offer_magnets' | t }}</h3><p>{{ 'site_refresh.offer_magnets_body' | t }}</p><span class="aef-link">{{ 'site_refresh.offer_magnets_cta' | t }}</span></div></a><a class="aef-offer-card" href="/products/the-magnetic-keepsake-frame"><div class="aef-offer-image">{% assign visual_product = all_products['the-magnetic-keepsake-frame'] %}{% if visual_product.featured_image != blank %}{{ visual_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 600, 1000', sizes: '(max-width: 749px) 100vw, 33vw', alt: '' }}{% endif %}</div><div class="aef-offer-copy"><h3>{{ 'site_refresh.offer_frames' | t }}</h3><p>{{ 'site_refresh.offer_frames_body' | t }}</p><span class="aef-link">{{ 'site_refresh.offer_frames_cta' | t }}</span></div></a></div></section>