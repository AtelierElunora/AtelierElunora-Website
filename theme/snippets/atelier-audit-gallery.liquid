{% doc %}
Displays existing product imagery as labeled design previews.
{% enddoc %}
<section class="ae-audit-gallery"><h1>{{ 'audit.gallery_title' | t }}</h1><p>{{ 'audit.gallery_body' | t }}</p><div class="ae-audit-gallery-grid">
{% assign gallery_handles = 'custom-photo-magnets,the-magnetic-keepsake-frame,wedding-event-photo-magnet-experience' | split: ',' %}
{% for handle in gallery_handles %}{% assign gallery_product = all_products[handle] %}{% if gallery_product != blank %}
<figure><a href="{{ gallery_product.url }}">{{ gallery_product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}</a><figcaption><small>{{ 'audit.preview' | t }}</small><h2>{{ gallery_product.title | escape }}</h2><a href="{{ gallery_product.url }}">{{ 'audit.view_product' | t }}</a></figcaption></figure>
{% endif %}{% endfor %}</div></section>
{% stylesheet %}.ae-audit-gallery{max-width:1200px;margin:auto;padding:60px 24px}.ae-audit-gallery>p{max-width:760px;line-height:1.6}.ae-audit-gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin-top:36px}.ae-audit-gallery figure{margin:0}.ae-audit-gallery img{width:100%;height:auto;aspect-ratio:1;object-fit:cover}.ae-audit-gallery figcaption{padding:20px 0}.ae-audit-gallery h2{font-size:24px}.ae-audit-gallery a{text-decoration:underline;text-underline-offset:4px}@media(max-width:749px){.ae-audit-gallery-grid{grid-template-columns:1fr}}{% endstylesheet %}
