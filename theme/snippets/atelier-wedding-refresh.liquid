{% doc %}
Renders the wedding and event page layouts.
@param {string} page_handle - Page handle selecting the layout.
@example
{% render 'atelier-wedding-refresh', page_handle: page.handle %}
{% enddoc %}
<div class="aew"><header class="aew-hero"><div>
<p class="aew-kicker">{{ 'wedding_refresh.eyebrow' | t }}</p>
{% if page_handle == 'packages' %}<h1>{{ 'wedding_refresh.collection_title' | t }}</h1><p class="aew-intro">{{ 'wedding_refresh.collection_intro' | t }}</p>
{% else %}<h1>{{ 'wedding_refresh.experience_title' | t }}</h1><p class="aew-intro">{{ 'wedding_refresh.experience_intro' | t }}</p>{% endif %}
<p>{{ 'event_travel.area' | t }}</p><p>{{ 'event_travel.included' | t }}</p><div class="aew-actions"><a class="aew-button" href="/products/wedding-event-photo-magnet-experience">{{ 'wedding_refresh.book' | t }}</a>{% unless page_handle == 'packages' %}<a href="/pages/packages">{{ 'wedding_refresh.pricing' | t }}</a>{% endunless %}</div>
</div>{% assign celebration_image = images["d4194dfcc9eb7ab33b70fd606c92e776.png"] %}{% if celebration_image != blank %}<div class="aew-photo">{{ celebration_image | image_url: width: 1400 | image_tag: loading: 'eager', sizes: '(max-width: 749px) 100vw, 48vw', widths: '480, 750, 1000, 1400', alt: '' }}</div>{% endif %}</header>
<section class="aew-section" aria-labelledby="aew-included"><p class="aew-kicker">{{ 'wedding_refresh.included' | t }}</p><h2 id="aew-included">{{ 'wedding_refresh.details' | t }}</h2><div class="aew-inclusions"><div class="aew-inclusion"><span class="aew-mark" aria-hidden="true">01</span><div><h3>{{ 'wedding_refresh.inclusion_title_0' | t }}</h3><p>{{ 'wedding_refresh.inclusion_body_0' | t }}</p></div></div><div class="aew-inclusion"><span class="aew-mark" aria-hidden="true">02</span><div><h3>{{ 'wedding_refresh.inclusion_title_1' | t }}</h3><p>{{ 'wedding_refresh.inclusion_body_1' | t }}</p></div></div><div class="aew-inclusion"><span class="aew-mark" aria-hidden="true">03</span><div><h3>{{ 'wedding_refresh.inclusion_title_2' | t }}</h3><p>{{ 'wedding_refresh.inclusion_body_2' | t }}</p></div></div><div class="aew-inclusion"><span class="aew-mark" aria-hidden="true">04</span><div><h3>{{ 'wedding_refresh.inclusion_title_3' | t }}</h3><p>{{ 'wedding_refresh.inclusion_body_3' | t }}</p></div></div><div class="aew-inclusion"><span class="aew-mark" aria-hidden="true">05</span><div><h3>{{ 'wedding_refresh.inclusion_title_4' | t }}</h3><p>{{ 'wedding_refresh.inclusion_body_4' | t }}</p></div></div><div class="aew-inclusion"><span class="aew-mark" aria-hidden="true">06</span><div><h3>{{ 'wedding_refresh.inclusion_title_5' | t }}</h3><p>{{ 'wedding_refresh.inclusion_body_5' | t }}</p></div></div></div></section>{% if page_handle == 'packages' %}<section class="aew-section" aria-labelledby="aew-choose"><p class="aew-kicker">{{ 'wedding_refresh.fit' | t }}</p><h2 id="aew-choose">{{ 'wedding_refresh.three' | t }}</h2><div class="aew-card-grid"><article class="aew-card"><p class="aew-kicker">{{ 'wedding_refresh.label_0' | t }}</p><h3>{{ 'wedding_refresh.tier_0' | t }}</h3><p class="aew-price">{{ 'wedding_refresh.price_0' | t }}</p><ul class="aew-stats"><li>{{ 'wedding_refresh.hours_0' | t }}</li><li>{{ 'wedding_refresh.magnets_0' | t }}</li><li>{{ 'wedding_refresh.staff_0' | t }}</li></ul><p class="aew-retainer">{{ 'wedding_refresh.retainer_0' | t }}</p><details><summary>{{ 'wedding_refresh.expand_0' | t }}</summary><ul><li>{{ 'wedding_refresh.detail_0_0' | t }}</li><li>{{ 'wedding_refresh.detail_0_1' | t }}</li></ul></details></article><article class="aew-card aew-featured"><p class="aew-kicker">{{ 'wedding_refresh.label_1' | t }}</p><h3>{{ 'wedding_refresh.tier_1' | t }}</h3><p class="aew-price">{{ 'wedding_refresh.price_1' | t }}</p><ul class="aew-stats"><li>{{ 'wedding_refresh.hours_1' | t }}</li><li>{{ 'wedding_refresh.magnets_1' | t }}</li><li>{{ 'wedding_refresh.staff_1' | t }}</li></ul><p class="aew-retainer">{{ 'wedding_refresh.retainer_1' | t }}</p><details><summary>{{ 'wedding_refresh.expand_1' | t }}</summary><ul><li>{{ 'wedding_refresh.detail_1_0' | t }}</li><li>{{ 'wedding_refresh.detail_1_1' | t }}</li><li>{{ 'wedding_refresh.detail_1_2' | t }}</li><li>{{ 'wedding_refresh.detail_1_3' | t }}</li></ul></details></article><article class="aew-card"><p class="aew-kicker">{{ 'wedding_refresh.label_2' | t }}</p><h3>{{ 'wedding_refresh.tier_2' | t }}</h3><p class="aew-price">{{ 'wedding_refresh.price_2' | t }}</p><ul class="aew-stats"><li>{{ 'wedding_refresh.hours_2' | t }}</li><li>{{ 'wedding_refresh.magnets_2' | t }}</li><li>{{ 'wedding_refresh.staff_2' | t }}</li></ul><p class="aew-retainer">{{ 'wedding_refresh.retainer_2' | t }}</p><details><summary>{{ 'wedding_refresh.expand_2' | t }}</summary><ul><li>{{ 'wedding_refresh.detail_2_0' | t }}</li><li>{{ 'wedding_refresh.detail_2_1' | t }}</li><li>{{ 'wedding_refresh.detail_2_2' | t }}</li><li>{{ 'wedding_refresh.detail_2_3' | t }}</li><li>{{ 'wedding_refresh.detail_2_4' | t }}</li></ul></details></article></div></section><section class="aew-section"><h2>{{ 'wedding_refresh.enhance' | t }}</h2><details><summary>{{ 'wedding_refresh.extras' | t }}</summary>{% assign addon_product_0 = all_products['additional-event-hour'] %}{% assign addon_product_1 = all_products['additional-50-magnets'] %}{% assign addon_product_2 = all_products['additional-100-magnets'] %}{% assign addon_product_6 = all_products['after-wedding-couple-magnet-collection'] %}{% assign addon_product_7 = all_products['premium-event-signage-suite'] %}{% assign addon_product_8 = all_products['custom-monogram-or-wedding-artwork'] %}{% assign addon_product_9 = all_products['early-setup-idle-time'] %}<dl class="aew-addons"><div><dt>{{ 'wedding_refresh.addon_0' | t }}</dt><dd>{% if addon_product_0 != blank %}{{ addon_product_0.price | money_without_trailing_zeros }}{% else %}{{ 'wedding_refresh.addon_price_0' | t }}{% endif %}</dd></div><div><dt>{{ 'wedding_refresh.addon_1' | t }}</dt><dd>{% if addon_product_1 != blank %}{{ addon_product_1.price | money_without_trailing_zeros }}{% else %}{{ 'wedding_refresh.addon_price_1' | t }}{% endif %}</dd></div><div><dt>{{ 'wedding_refresh.addon_2' | t }}</dt><dd>{% if addon_product_2 != blank %}{{ addon_product_2.price | money_without_trailing_zeros }}{% else %}{{ 'wedding_refresh.addon_price_2' | t }}{% endif %}</dd></div><div><dt>{{ 'wedding_refresh.addon_6' | t }}</dt><dd>{% if addon_product_6 != blank %}{{ addon_product_6.price | money_without_trailing_zeros }}{% else %}{{ 'wedding_refresh.addon_price_6' | t }}{% endif %}</dd></div><div><dt>{{ 'wedding_refresh.addon_7' | t }}</dt><dd>{% if addon_product_7 != blank %}{{ addon_product_7.price | money_without_trailing_zeros }}{% else %}{{ 'wedding_refresh.addon_price_7' | t }}{% endif %}</dd></div><div><dt>{{ 'wedding_refresh.addon_8' | t }}</dt><dd>{% if addon_product_8 != blank %}{{ addon_product_8.price | money_without_trailing_zeros }}{% else %}{{ 'wedding_refresh.addon_price_8' | t }}{% endif %}</dd></div><div><dt>{{ 'wedding_refresh.addon_9' | t }}</dt><dd>{% if addon_product_9 != blank %}{{ addon_product_9.price | money_without_trailing_zeros }} {{ 'wedding_refresh.per_hour' | t }}{% else %}{{ 'wedding_refresh.addon_price_9' | t }}{% endif %}</dd></div></dl><p>{{ 'wedding_refresh.travel' | t }}</p><a href="{{ routes.collections_url }}/event-add-ons">{{ 'wedding_refresh.addons_link' | t }}</a></details><details><summary>{{ 'wedding_refresh.reserve' | t }}</summary><p>{{ 'wedding_refresh.terms' | t }}</p></details></section>
{% else %}<section class="aew-section" aria-labelledby="aew-steps"><p class="aew-kicker">{{ 'wedding_refresh.steps_kicker' | t }}</p><h2 id="aew-steps">{{ 'wedding_refresh.steps_title' | t }}</h2><ol class="aew-steps"><li><span class="aew-number" aria-hidden="true">01</span><h3>{{ 'wedding_refresh.step_title_0' | t }}</h3><p>{{ 'wedding_refresh.step_body_0' | t }}</p></li><li><span class="aew-number" aria-hidden="true">02</span><h3>{{ 'wedding_refresh.step_title_1' | t }}</h3><p>{{ 'wedding_refresh.step_body_1' | t }}</p></li><li><span class="aew-number" aria-hidden="true">03</span><h3>{{ 'wedding_refresh.step_title_2' | t }}</h3><p>{{ 'wedding_refresh.step_body_2' | t }}</p></li></ol></section>{% endif %}{% render 'atelier-event-travel' %}<section class="aew-final"><p class="aew-kicker">{{ 'wedding_refresh.final_kicker' | t }}</p><h2>{{ 'wedding_refresh.final_title' | t }}</h2><a class="aew-button" href="/products/wedding-event-photo-magnet-experience">{{ 'wedding_refresh.final_cta' | t }}</a></section></div>
{% stylesheet %}
.aew{max-width:1240px;margin:auto;padding:48px 32px 72px;color:#252b1d}
.aew .aew-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:center}
.aew h1{font-size:clamp(32px,4.3vw,58px);line-height:1.12;margin:0 0 24px;max-width:15ch;text-wrap:balance}
.aew h2{font-size:clamp(27px,3vw,38px);line-height:1.2;margin:0 0 30px;text-wrap:balance}
.aew h3{font-size:21px;line-height:1.3;margin:0 0 10px}
.aew p,.aew li,.aew dt,.aew dd,.aew summary{font-size:16px;line-height:1.6}
.aew p{margin:0 0 16px}.aew .aew-intro{max-width:43ch;font-size:18px}
.aew .aew-kicker{font-size:11px;line-height:1.6;letter-spacing:.12em;text-transform:uppercase;margin:0 0 16px}
.aew .aew-photo{aspect-ratio:4/5;overflow:hidden;background:#d6d2bc}.aew .aew-photo img{display:block;width:100%;height:100%;object-fit:cover}
.aew .aew-actions{display:flex;gap:20px;align-items:center;flex-wrap:wrap;margin-top:28px}
.aew a{font-size:14px;text-underline-offset:5px}.aew a.aew-button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:14px 22px;background:#252b1d;color:#f4f2ef;border:1px solid #252b1d;text-decoration:none;line-height:1.5;text-align:center}.aew a.aew-button:hover{background:#4a4b36}
.aew a:focus-visible,.aew summary:focus-visible{outline:2px solid #252b1d;outline-offset:5px}
.aew .aew-section{padding:64px 0;border-bottom:1px solid #b19a7366}
.aew .aew-inclusions{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 28px}
.aew .aew-inclusion{display:flex;align-items:flex-start;gap:15px}.aew .aew-inclusion p{font-size:15px;margin:0}
.aew .aew-mark{flex:0 0 38px;height:38px;border:1px solid #b19a73;border-radius:50%;display:grid;place-items:center;font-size:13px}
.aew .aew-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;align-items:start}
.aew .aew-card{padding:28px 24px;border:1px solid #b19a7388;background:#f4f2ef}.aew .aew-featured{border:2px solid #4a4b36;padding:27px 23px}
.aew .aew-price{font-size:38px;line-height:1.2;margin:20px 0}
.aew .aew-stats{list-style:none;padding:18px 0;margin:0;border-block:1px solid #d6d2bc}.aew .aew-stats li{padding:3px 0}
.aew .aew-retainer{font-size:13px;margin:16px 0}
.aew details{border-top:1px solid #d6d2bc;padding:16px 0}.aew summary{cursor:pointer;font-size:15px}
.aew details ul{padding-left:20px;margin:18px 0 0}.aew details li{font-size:14px;margin-bottom:8px}.aew details p{margin-top:16px}
.aew .aew-addons{margin:20px 0}.aew .aew-addons div{display:flex;gap:20px;justify-content:space-between;border-bottom:1px solid #d6d2bc;padding:12px 0}.aew .aew-addons dd{margin:0;white-space:nowrap}
.aew .aew-steps{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px}.aew .aew-number{display:block;font-size:44px;color:#766345;line-height:1;margin:0 0 22px}
.aew .aew-final{text-align:center;padding:64px 24px 0}.aew .aew-final h2{margin-bottom:24px}
@media(max-width:900px){.aew .aew-hero{gap:28px}.aew .aew-inclusions{grid-template-columns:repeat(2,minmax(0,1fr))}.aew .aew-card-grid{grid-template-columns:1fr}.aew .aew-card{padding:28px}}
@media(max-width:749px){.aew{padding:24px 20px 48px}.aew .aew-hero{grid-template-columns:1fr;gap:24px}.aew .aew-photo{aspect-ratio:4/3}.aew .aew-section{padding:40px 0}.aew .aew-inclusions{grid-template-columns:1fr;gap:24px}.aew .aew-steps{grid-template-columns:1fr;gap:24px}.aew .aew-steps li{padding-bottom:18px;border-bottom:1px solid #d6d2bc}.aew .aew-number{font-size:32px;margin-bottom:14px}.aew .aew-final{padding:40px 0 0}.aew .aew-addons dt,.aew .aew-addons dd{font-size:14px}}
{% endstylesheet %}
