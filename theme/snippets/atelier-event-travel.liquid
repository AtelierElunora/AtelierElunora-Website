{% doc %}
Displays the Strongsville event service area and travel fee policy.
{% enddoc %}
<section id="event-travel" class="ae-event-travel" aria-labelledby="event-travel-heading"><h2 id="event-travel-heading">{{ 'event_travel.heading' | t }}</h2><p>{{ 'event_travel.area' | t }}</p><table><thead><tr><th scope="col">{{ 'event_travel.distance' | t }}</th><th scope="col">{{ 'event_travel.fee' | t }}</th></tr></thead><tbody><tr><th scope="row">{{ 'event_travel.band_0' | t }}</th><td>{{ 'event_travel.fee_0' | t }}</td></tr><tr><th scope="row">{{ 'event_travel.band_1' | t }}</th><td>{{ 'event_travel.fee_1' | t }}</td></tr><tr><th scope="row">{{ 'event_travel.band_2' | t }}</th><td>{{ 'event_travel.fee_2' | t }}</td></tr><tr><th scope="row">{{ 'event_travel.band_3' | t }}</th><td>{{ 'event_travel.fee_3' | t }}</td></tr></tbody></table><p>{{ 'event_travel.measure' | t }}</p><p>{{ 'event_travel.before' | t }}</p><p>{{ 'event_travel.lodging' | t }}</p><a href="/pages/contact">{{ 'event_travel.contact' | t }}</a></section>
{% stylesheet %}
.ae-event-travel{padding:36px 0;scroll-margin-top:100px;color:inherit}.ae-event-travel table{width:100%;border-collapse:collapse;margin:20px 0;font-size:15px;line-height:1.5}.ae-event-travel th,.ae-event-travel td{text-align:left;padding:14px 12px;border-bottom:1px solid #d6d2bc;vertical-align:top}.ae-event-travel tbody th{font-weight:400}.ae-event-travel thead{background:#ebe5d9;color:#252b1d}.ae-event-travel p{max-width:76ch;line-height:1.6}.ae-event-travel a{text-underline-offset:4px}.ae-event-travel a:focus-visible{outline:2px solid currentColor;outline-offset:4px}@media(max-width:749px){.ae-event-travel{padding:28px 0}.ae-event-travel th,.ae-event-travel td{padding:12px 8px;font-size:14px}.ae-event-travel th:first-child{width:65%}}
{% endstylesheet %}
