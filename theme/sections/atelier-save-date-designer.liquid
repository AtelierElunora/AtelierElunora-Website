{% schema %}
{
  "name": "t:save_dates.designer_section",
  "settings": [],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "New occasion" },
        { "type": "text", "id": "key", "label": "Link key", "info": "Used in links like ?occasion=christmas. Lowercase, no spaces.", "default": "occasion" },
        { "type": "text", "id": "heading", "label": "Card heading", "default": "Save the date" },
