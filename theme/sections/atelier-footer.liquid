<footer class="ae-footer"><div class="ae-footer__inner"><div class="ae-footer__brand"><img src="{{ 'atelier-logo-white.png' | asset_url }}" alt="Atelier Elunora" width="340" height="150"><p>{{ 'brand.footer_tagline' | t }}</p></div><div class="ae-footer__links"><div><span>Explore</span><a href="/pages/event-experience">The Experience</a><a href="/pages/packages">Weddings &amp; Events</a><a href="{{ routes.collections_url }}/photo-magnets">Shop Magnets</a><a href="/pages/gallery">Gallery</a></div><div><span>Connect</span><a href="/pages/about">About the Atelier</a><a href="/pages/contact">Inquire</a><a href="/pages/faq">FAQ</a><a href="{{ routes.cart_url }}">Cart</a></div></div></div><div class="ae-footer__bottom"><nav aria-label="{{ 'audit.policies' | t }}" class="ae-audit-policy-links">{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}<a href="/pages/data-sharing-opt-out">{{ 'audit.privacy_choices' | t }}</a><a href="mailto:{{ shop.email | escape }}">{{ shop.email | escape }}</a></nav><small>&copy; {{ 'now' | date: '%Y' }} Atelier Elunora. Made for meaningful moments.</small></div></footer>{% stylesheet %}.ae-audit-policy-links{display:flex;flex-wrap:wrap;gap:16px;margin-bottom:20px}.ae-audit-policy-links a{color:inherit;text-decoration:underline;text-underline-offset:4px}{% endstylesheet %}{% schema %}{"name":"Atelier branded footer","settings":[]}{% endschema %}
