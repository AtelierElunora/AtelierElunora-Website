   const r=await fetch(cartURL+'/add.js',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:[{id:p.variant,quantity:1,properties:state.properties}]})});
   if(!r.ok)throw Error(t.cartFailed);
   if(!existing(await readCart()))throw Error(t.cartFailed);
  }
  notice.textContent=t.cartOpening;dirty=false;location.assign(cartURL);
 }
 async function cartCrop(item){
  const zoom=item.zoom===undefined?1:Number(item.zoom);
  if(!Number.isFinite(zoom)||zoom<1||zoom>3||![item.x,item.y].every(v=>Number.isFinite(v)&&v>=0&&v<=100))throw Error(t.retry);
  const u=new URL(item.url);
  if(u.origin!=='https://gefdlubvqymyxrguhtnc.supabase.co'||!u.pathname.startsWith('/storage/v1/object/sign/gallery-originals/'))throw Error(t.retry);
  const r=await fetch(u.href,{credentials:'omit',cache:'no-store',signal:AbortSignal.timeout(60000)});if(!r.ok)throw Error(t.cartFailed);
  const blob=await r.blob();if(blob.size>15728640||!['image/jpeg','image/png','image/webp'].includes(blob.type))throw Error(t.cartFailed);
  const bitmap=await createImageBitmap(blob,{imageOrientation:'from-image'});
  try{
   const side=Math.min(bitmap.width,bitmap.height)/zoom,size=Math.max(1,Math.round(Math.min(side,3000)));
   if(!side||bitmap.width*bitmap.height>60000000)throw Error(t.cartFailed);
   const canvas=document.createElement('canvas');canvas.width=canvas.height=size;
   const ctx=canvas.getContext('2d');if(!ctx)throw Error(t.cartFailed);
   ctx.fillStyle='#ffffff';ctx.fillRect(0,0,size,size);ctx.drawImage(bitmap,(bitmap.width-side)*item.x/100,(bitmap.height-side)*item.y/100,side,side,0,0,size,size);
   const jpeg=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',0.95));canvas.width=canvas.height=1;
   if(!jpeg||jpeg.size>15728640)throw Error(t.cartFailed);return jpeg;
  }finally{bitmap.close();}
 }

