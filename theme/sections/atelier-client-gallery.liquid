   const group=await r.json();
   if(!/^[a-f0-9-]{36}~\d+$/i.test(group.id||'')||Number(group.files_count)!==pack||!Array.isArray(group.files)||group.files.length!==pack||group.files.some((f,i)=>f?.uuid!==state.files[i]))throw Error(t.cartFailed);
   state.properties={'Gallery selection':manifest.reference,'Magnet count':String(pack),'__image_group':'https://ucarecdn.com/'+group.id+'/','__image_group_id':group.id,'__image_previews':JSON.stringify(state.files.map(id=>'https://ucarecdn.com/'+id+'/'))};
  }
  const fresh=await api('events/'+event.id+'/checkout',request);
  if(fresh.reference!==manifest.reference||String(fresh.variant)!==String(p.variant)||fresh.count!==pack)throw Error(t.retry);
