{% stylesheet %}
[data-ae-customer-gallery]{background:#F4F2EF;color:#4A4B36}
.ag-shell{max-width:1280px;margin:auto;padding:48px 24px 72px;font:16px/1.6 Arial,sans-serif}
.ag-shell [hidden]{display:none!important}.ag-shell *{box-sizing:border-box}
.ag-shell h1,.ag-shell h2,.ag-shell h3{font-family:var(--ae-heading,"Brown Carolina Sans",serif);font-weight:400;color:#4A4B36}
.ag-shell h1{font-size:clamp(42px,7vw,76px);margin:12px 0}.ag-shell h2{font-size:32px}
.ag-intro{text-align:center;margin-bottom:36px}.ag-intro>p{max-width:620px;margin:12px auto}.ag-eyebrow{letter-spacing:.18em;font-size:12px}
.ag-shell button,.ag-shell input,.ag-shell select{font:inherit;border:1px solid #888D6F;border-radius:0;min-height:46px}
.ag-shell button{cursor:pointer;padding:10px 18px;background:#4A4B36;color:#F4F2EF}
.ag-shell button:disabled{opacity:.5;cursor:not-allowed}
.ag-shell button:focus-visible,.ag-shell input:focus-visible,.ag-shell select:focus-visible{outline:3px solid #B19A73;outline-offset:3px}
.ag-shell input,.ag-shell select{padding:9px 12px;background:#fff;color:#4A4B36;max-width:100%}
.ag-shell label{display:block}.ag-login{max-width:480px;background:#E8E5D9;border:1px solid #D6D2BC;margin:auto;padding:28px}
.ag-login input,.ag-login button{width:100%;margin:8px 0}.ag-login p{font-size:14px}
.ag-notice:empty,.ag-error:empty{display:none}.ag-notice{padding:14px;background:#E8E5D9}.ag-error{padding:14px;border:1px solid #8b3535;color:#752e2e}
.ag-bar,.ag-controls{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:20px 0}.ag-bar span{margin-right:auto;overflow-wrap:anywhere}.ag-summary{font-weight:bold}
.ag-stepper{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;list-style:none;margin:28px 0 34px;padding:0}.ag-stepper li{display:flex;align-items:center;gap:9px;padding:11px 4px;border-top:2px solid #D6D2BC;color:#888D6F;font-size:13px}.ag-stepper li[aria-current=step]{border-color:#4A4B36;color:#4A4B36;font-weight:700}.ag-step-number{display:grid;width:25px;height:25px;border:1px solid currentColor;border-radius:50%;place-items:center;font-size:12px}.ag-step{animation:ag-step-in .24s ease}.ag-step h3{font-size:30px;margin:0 0 12px}@keyframes ag-step-in{from{opacity:.35;transform:translateY(5px)}to{opacity:1;transform:none}}
.ag-pack-picker{border:0;margin:28px 0 12px;padding:0;min-width:0}.ag-pack-picker legend{font-family:var(--ae-heading,"Brown Carolina Sans",serif);font-size:28px;line-height:1.2;margin-bottom:14px;color:#4A4B36}
.ag-pack-cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.ag-pack-card{position:relative;display:block;min-width:0;cursor:pointer}.ag-pack-card>input{position:absolute;opacity:0;width:1px;height:1px;min-height:1px;margin:0}.ag-pack-card-content{position:relative;display:block;min-height:0;padding:0 0 14px;border:2px solid transparent;background:#E8E5D9;color:#4A4B36;overflow:hidden;transition:border-color .18s ease,box-shadow .18s ease,transform .18s ease}.ag-pack-card:hover .ag-pack-card-content{transform:translateY(-2px)}
.ag-pack-card>input:checked+.ag-pack-card-content{border-color:#4A4B36;box-shadow:0 0 0 1px #4A4B36}.ag-pack-card>input:checked+.ag-pack-card-content::before{content:'✓';position:absolute;z-index:2;top:10px;left:10px;display:grid;width:30px;height:30px;border-radius:50%;place-items:center;background:#4A4B36;color:#F4F2EF;font-size:17px}.ag-pack-card>input:focus-visible+.ag-pack-card-content{outline:3px solid #B19A73;outline-offset:3px}.ag-pack-card>input:disabled+.ag-pack-card-content{opacity:.55;cursor:not-allowed;transform:none}.ag-pack-media{display:block;width:100%;aspect-ratio:4/5;background:#D6D2BC;overflow:hidden}.ag-pack-media img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s ease}.ag-pack-card:hover .ag-pack-media img{transform:scale(1.015)}.ag-pack-title,.ag-pack-price{display:block;padding:0 12px;font-family:var(--ae-heading,"Brown Carolina Sans",serif)}.ag-pack-title{margin-top:12px;color:#292514;font-size:14px;line-height:1.3}.ag-pack-price{margin-top:5px;font-size:16px;line-height:1.1}.ag-pack-badge{position:absolute;z-index:2;top:10px;right:10px;padding:5px 8px;background:#B19A73;color:#fff;font-size:10px;line-height:1.2;text-transform:uppercase;letter-spacing:.08em}.ag-pack-card>input:checked+.ag-pack-card-content .ag-pack-badge{background:#F4F2EF;color:#4A4B36}
.ag-pack-next{display:flex;justify-content:flex-end;margin-top:20px}.ag-pack-next button{min-width:200px}.ag-secondary{background:transparent!important;color:#4A4B36!important}.ag-photo-progress{position:sticky;z-index:4;bottom:8px;display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:24px;padding:14px 16px;border:1px solid #D6D2BC;background:#F4F2EF;box-shadow:0 8px 28px #2925141f}.ag-photo-progress .ag-summary{margin:0}.ag-photo-progress button{flex:0 0 auto}
.ag-booth-open{display:inline-block;color:#4A4B36;padding:12px;margin-inline-end:12px;text-decoration:underline}.ag-booth-open:focus-visible{outline:3px solid #B19A73;outline-offset:3px}
.ag-events{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
.ag-grid{display:grid;gap:20px;grid-template-columns:repeat(3,minmax(0,1fr));margin:24px 0}
.ag-card{background:#fff;border:2px solid transparent;padding:10px;min-width:0}.ag-card.ag-chosen{border-color:#4A4B36;background:#E8E5D9}
.ag-card>img{width:100%;height:auto;aspect-ratio:1;object-fit:cover;background:#D6D2BC}
.ag-card label{display:flex;align-items:center;gap:10px;overflow-wrap:anywhere;min-height:48px;font-size:14px}
.ag-card input[type=checkbox]{width:22px;height:22px;min-height:22px;accent-color:#4A4B36;flex-shrink:0}.ag-card button{width:100%}
.ag-dialog{max-width:540px;width:calc(100% - 32px);max-height:90vh;overflow:auto;border:1px solid #888D6F;background:#F4F2EF;color:#4A4B36;padding:24px}
.ag-dialog::backdrop{background:#0009}.ag-dialog img{width:100%;aspect-ratio:1;object-fit:cover}.ag-dialog input{display:block;width:100%;margin:8px 0}.ag-dialog button{width:100%;margin-top:12px}
.ag-review{border:1px solid #888D6F;padding:24px}.ag-review-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.ag-review-item img{width:100%;aspect-ratio:1;object-fit:cover}.ag-review-item{overflow-wrap:anywhere}.ag-review>button{margin:8px 8px 0 0}
@media(max-width:749px){.ag-shell{padding:32px 16px 48px}.ag-stepper{margin:22px 0 28px}.ag-stepper li{display:block;padding:8px 2px;font-size:11px}.ag-step-number{margin-bottom:6px}.ag-pack-cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ag-pack-title{font-size:13px}.ag-pack-badge{top:8px;right:8px;font-size:9px}.ag-pack-card>input:checked+.ag-pack-card-content::before{top:8px;left:8px;width:27px;height:27px}.ag-pack-next button{width:100%}.ag-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ag-card{padding:6px}.ag-card label{font-size:12px}.ag-card button{font-size:14px;padding:8px}.ag-controls>*{flex:1 1 40%}.ag-photo-progress{bottom:6px;display:block;padding:10px}.ag-photo-progress .ag-summary{margin:0 0 8px;text-align:center;font-size:14px}.ag-photo-progress button{width:100%}.ag-review-list{grid-template-columns:repeat(2,minmax(0,1fr))}.ag-login{padding:20px}}

.ag-crop-viewport{width:100%;aspect-ratio:1;overflow:hidden;background:#D6D2BC}.ag-crop-viewport>img{display:block;width:100%;height:100%;object-fit:cover}.ag-dialog output{float:right;font-variant-numeric:tabular-nums}

{% endstylesheet %}
<script src="{{ 'atelier-product-upload.js' | asset_url }}" defer></script>
