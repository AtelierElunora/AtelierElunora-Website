<section class="ae-home"><div class="ae-hero"><div class="ae-hero__photo" style="background-image:url('{{ images["d4194dfcc9eb7ab33b70fd606c92e776.png"] | image_url: width: 2400 }}')" role="img" aria-label="A celebration captured as an Atelier Elunora keepsake"></div><div class="ae-hero__veil"></div><div class="ae-hero__brand"><img src="{{ 'atelier-logo-white.png' | asset_url }}" alt="Atelier Elunora" width="760" height="330"></div><div class="ae-audit-hero-copy"><h1>{{ 'audit.hero_title' | t }}</h1><p>{{ 'audit.hero_body' | t }}</p><div class="ae-actions"><a class="ae-button ae-button--light" href="{{ routes.collections_url }}/photo-magnets">{{ 'audit.shop' | t }}</a><a class="ae-button ae-button--light" href="/pages/packages">{{ 'audit.events' | t }}</a></div></div></div><section class="ae-intro ae-cream"><p class="ae-kicker">The Atelier Elunora Experience</p><h2>Every moment, held in place.</h2><p class="ae-lede">We turn the photographs and fleeting moments from your celebration into beautifully made keepsakes your guests can take home, display, and remember.</p><p>{{ 'event_travel.home' | t }} <a class="ae-text-link" href="/pages/packages#event-travel">{{ 'event_travel.link' | t }}</a></p><div class="ae-actions"><a class="ae-button" href="/products/wedding-event-photo-magnet-experience">Plan your event</a><a class="ae-text-link" href="{{ routes.collections_url }}/photo-magnets">Just need magnets? Shop the Atelier →</a></div><div class="ae-photo-scatter" aria-hidden="true"><span></span><span></span><span></span></div></section><section class="ae-about ae-olive"><div class="ae-about__copy"><p class="ae-kicker ae-kicker--light">About the Atelier</p><p class="ae-script">Thoughtful keepsakes.</p><h2>Lasting memories.</h2><p>Atelier Elunora was created around a simple idea: the best event favors should feel personal. Our live experience gives guests something tangible from a night they never want to forget.</p><a class="ae-link-light" href="/pages/about">Read more →</a></div><div class="ae-about__art"><div class="ae-frame ae-frame--one" style="background-image:url('{{ images["9e994ab4e83068747e93a5a6c99e98fa.png"] | image_url: width: 1200 }}')"></div><div class="ae-frame ae-frame--two" style="background-image:url('{{ images["f49810e7618c238335257452226df157.png"] | image_url: width: 1200 }}')"></div></div></section>{% render 'atelier-offer-refresh' %}<section class="ae-process ae-olive"><p class="ae-kicker ae-kicker--light">How it’s made</p><h2>From your moment <span>to their mantel.</span></h2><div class="ae-process__steps"><div><b>01</b><h3>Capture</h3><p>Your guests share the moments worth keeping.</p></div><div><b>02</b><h3>Create</h3><p>Each image is prepared with a refined, event-ready finish.</p></div><div><b>03</b><h3>Craft</h3><p>We print and press each keepsake with care.</p></div><div><b>04</b><h3>Take Home</h3><p>Your guests leave with a tangible piece of the celebration.</p></div></div></section><section class="ae-shop-feature ae-cream"><div class="ae-shop-feature__copy"><p class="ae-kicker">The Atelier Shop</p><h2>Your favorite moments, made magnetic.</h2><p>You don’t need an event to make something meaningful. Order premium 2.5-inch square photo magnets from home in sets of 6, 12, 24, or 48.</p><p class="ae-price">Sets from {{ all_products['custom-photo-magnets'].price_min | money_without_trailing_zeros }}</p><a class="ae-button" href="/products/custom-photo-magnets">Create your magnets</a></div><a class="ae-shop-feature__visual" href="/products/custom-photo-magnets" aria-label="Shop 2.5 inch square photo magnets"><img src="{{ 'atelier-icon-gold.png' | asset_url }}" alt="" width="300" height="300"><span>Personalized · printed · made to keep</span></a></section><section class="ae-quote ae-cream"><p class="ae-kicker">{{ 'audit.brand_statement' | t }}</p><h2>{{ 'audit.brand_promise' | t }}</h2><span>Designed to feel considered, personal, and beautifully yours.</span></section><section class="ae-final-cta"><div><p class="ae-kicker ae-kicker--light">Your celebration, your keepsake</p><h2>Let’s create something<br><em>unforgettable, together.</em></h2><a class="ae-button ae-button--light" href="/pages/contact">Inquire</a></div></section></section>{% stylesheet %}
body.ae-site .ae-hero{height:auto!important;min-height:620px!important;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 24px;gap:20px}
body.ae-site .ae-hero__brand{position:relative!important;inset:auto!important;transform:none!important;z-index:2;width:min(360px,65vw)!important;margin:0!important}
body.ae-site .ae-hero__brand img{width:100%!important;height:auto!important}
.ae-audit-hero-copy{position:relative;z-index:2;text-align:center;color:#F4F2EF;max-width:740px}
body.ae-site .ae-audit-hero-copy h1{color:#F4F2EF!important;font-size:clamp(32px,4vw,54px);line-height:1.1;margin:0 0 16px}
.ae-audit-hero-copy p{font-size:18px;line-height:1.5;margin:0 auto 24px;max-width:620px}
.ae-audit-hero-copy .ae-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px}
.ae-audit-hero-copy .ae-button{min-height:48px}
@media(max-width:749px){body.ae-site .ae-hero{min-height:560px!important;padding:32px 20px}.ae-audit-hero-copy p{font-size:16px}.ae-audit-hero-copy .ae-actions{flex-direction:column}.ae-audit-hero-copy .ae-button{width:100%}}
{% endstylesheet %}
