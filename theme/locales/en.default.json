    "mix_help": "Request help with my order",
    "frame_image_q": "What about the main framed image?",
    "frame_image_a": "Your main framed display image is chosen separately from the photographs for your magnets. Follow the instructions in your personalization email.",
    "permissions_q": "What image permissions do I need?",
    "permissions_a": "Submit images you own or have permission to reproduce, with the necessary consent for recognizable people, including minors where applicable.",
